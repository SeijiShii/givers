server {
    listen 80;
    server_name dev.givers.work;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name dev.givers.work;

    ssl_certificate /etc/letsencrypt/live/dev.givers.work/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.givers.work/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 10M;

    # ログ — ホストマウント先 + docker logs 両方に出力
    access_log /var/log/nginx/access.log combined;
    access_log /dev/stdout combined;
    error_log /var/log/nginx/error.log warn;
    error_log /dev/stderr warn;

    # 機密ファイル・ディレクトリへのアクセスをブロック
    location ~ /\.(env|git|DS_Store|htpasswd|htaccess) {
        return 404;
    }
    location ~ /\.(sql|bak|swp|log)$ {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://frontend:4321;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
