# ===========================================
# GIVErS 本番環境変数 (.env.prod)
# コピーして .env.prod を作成し、値を設定する
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=givers
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=givers
DATABASE_URL=postgres://givers:CHANGE_ME_STRONG_PASSWORD@db:5432/givers?sslmode=disable

# --- Backend ---
FRONTEND_URL=https://givers.work
BACKEND_URL=https://givers.work
AUTH_REQUIRED=true
SESSION_SECRET=CHANGE_ME_32BYTE_RANDOM_BASE64
LOG_LEVEL=info

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Admin ---
HOST_EMAILS=
OFFICIAL_DOMAIN=https://givers.work

# --- Frontend ---
PUBLIC_API_URL=https://givers.work
PUBLIC_MOCK_MODE=false
PUBLIC_PLATFORM_PROJECT_ID=
PUBLIC_OFFICIAL_URL=https://givers.work

# --- Domain / SSL ---
DOMAIN=givers.work
CERTBOT_EMAIL=your-email@example.com
