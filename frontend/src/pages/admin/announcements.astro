---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminAnnouncementList from '../../components/react/AdminAnnouncementList';
import { t } from '../../lib/i18n';

const locale = 'ja';
---

<BaseLayout title={t(locale, 'admin.announcements')} locale={locale}>
  <AdminAnnouncementList
    client:load
    locale={locale}
    title={t(locale, 'admin.announcements')}
    forbiddenMessage={t(locale, 'admin.forbidden')}
    createLabel={t(locale, 'admin.announcementCreate')}
    editLabel={t(locale, 'admin.announcementEdit')}
    titleLabel={t(locale, 'admin.announcementTitle')}
    bodyLabel={t(locale, 'admin.announcementBody')}
    severityLabel={t(locale, 'admin.announcementSeverity')}
    publishLabel={t(locale, 'admin.announcementPublish')}
    hideLabel={t(locale, 'admin.announcementHide')}
    submitLabel={t(locale, 'admin.announcementSubmit')}
    submitScheduledLabel={t(locale, 'admin.announcementSubmitScheduled')}
    updateLabel={t(locale, 'admin.announcementUpdate')}
    scheduleLabel={t(locale, 'admin.announcementSchedule')}
    scheduledAtLabel={t(locale, 'admin.announcementScheduledAt')}
    statusPublished={t(locale, 'admin.announcementStatusPublished')}
    statusScheduled={t(locale, 'admin.announcementStatusScheduled')}
    statusHidden={t(locale, 'admin.announcementStatusHidden')}
  />
</BaseLayout>
