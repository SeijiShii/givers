---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminAlertList from '../../components/react/AdminAlertList';
import { t } from '../../lib/i18n';

const locale = 'ja';
---

<BaseLayout title={t(locale, 'admin.alertsTitle')} locale={locale}>
  <AdminAlertList
    client:load
    locale={locale}
    title={t(locale, 'admin.alertsTitle')}
    forbiddenMessage={t(locale, 'admin.forbidden')}
    emptyLabel={t(locale, 'admin.alertsEmpty')}
    filterAllLabel={t(locale, 'admin.alertFilterAll')}
    filterNewLabel={t(locale, 'admin.alertFilterNew')}
    filterAcknowledgedLabel={t(locale, 'admin.alertFilterAcknowledged')}
    filterResolvedLabel={t(locale, 'admin.alertFilterResolved')}
    statusNewLabel={t(locale, 'admin.alertStatusNew')}
    statusAcknowledgedLabel={t(locale, 'admin.alertStatusAcknowledged')}
    statusResolvedLabel={t(locale, 'admin.alertStatusResolved')}
    acknowledgeLabel={t(locale, 'admin.alertAcknowledge')}
    resolveLabel={t(locale, 'admin.alertResolve')}
    reopenLabel={t(locale, 'admin.alertReopen')}
    typeSelfDealingLabel={t(locale, 'admin.alertTypeSelfDealing')}
    typeHighFrequencyLabel={t(locale, 'admin.alertTypeHighFrequency')}
    typeHighAmountLabel={t(locale, 'admin.alertTypeHighAmount')}
    typeRoundTrippingLabel={t(locale, 'admin.alertTypeRoundTripping')}
    severityWarningLabel={t(locale, 'admin.alertSeverityWarning')}
    severityCriticalLabel={t(locale, 'admin.alertSeverityCritical')}
    projectLabel={t(locale, 'admin.alertProject')}
    donorLabel={t(locale, 'admin.alertDonor')}
    loadingLabel={t(locale, 'projects.loading')}
    loadMoreLabel={t(locale, 'admin.alertLoadMore')}
  />
</BaseLayout>
