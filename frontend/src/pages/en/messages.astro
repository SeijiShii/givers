---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MessageThreadList from '../../components/react/MessageThreadList';
import { t } from '../../lib/i18n';

const locale = 'en';
---

<BaseLayout title={t(locale, 'messages.title')} locale={locale}>
  <MessageThreadList
    client:load
    locale={locale}
    basePath="/en"
  />
</BaseLayout>
