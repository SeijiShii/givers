---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementList from '../components/react/AnnouncementList';
import { t } from '../lib/i18n';

const locale = 'ja';
---

<BaseLayout title={t(locale, 'announcements.title')} locale={locale}>
  <AnnouncementList
    client:load
    locale={locale}
    basePath=""
    title={t(locale, 'announcements.title')}
    emptyLabel={t(locale, 'announcements.empty')}
    loadMoreLabel={t(locale, 'announcements.loadMore')}
    manageLabel={t(locale, 'announcements.manage')}
  />
</BaseLayout>
