---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/react/ProjectList';
import NewProjectCta from '../../components/react/NewProjectCta';
import { t } from '../../lib/i18n';

const locale = 'ja';
---

<BaseLayout title={t(locale, 'projects.title')} locale={locale}>
  <h1>{t(locale, 'projects.title')}</h1>
  <p>{t(locale, 'projects.description')}</p>

  <NewProjectCta client:load locale={locale} newProjectUrl="/projects/new" />

  <ProjectList client:load locale={locale} platformBadge={t(locale, 'platformProject.badge')} />
</BaseLayout>
