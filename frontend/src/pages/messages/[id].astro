---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import MessageThreadView from '../../components/react/MessageThreadView';
import { t } from '../../lib/i18n';

const locale = 'ja';
const { id } = Astro.params;
---

<BaseLayout title={t(locale, 'messages.title')} locale={locale}>
  <MessageThreadView
    client:load
    threadId={id!}
    locale={locale}
    basePath=""
  />
</BaseLayout>
